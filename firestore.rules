rules_version = '2';

// Доступ выдаётся документом access/{email} с полем role: 'admin' | 'viewer' | 'employee'.
// Сотрудник (employee, с полем member_id) видит только свою выписку statements/{member_id} и свои документы.
// Первого администратора создайте вручную в консоли Firebase (см. README).
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth.token.email.lower();
    }
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function accessPath() {
      return /databases/$(database)/documents/access/$(email());
    }
    function myAccess() {
      return get(accessPath()).data;
    }
    // Админ и наблюдатель видят все данные студии
    function canRead() {
      return signedIn() && exists(accessPath()) && myAccess().role in ['admin', 'viewer'];
    }
    function isAdmin() {
      return signedIn() && exists(accessPath()) && myAccess().role == 'admin';
    }
    function isEmployee(memberId) {
      return signedIn() && exists(accessPath())
        && myAccess().role == 'employee' && myAccess().get('member_id', '') == memberId;
    }

    // ---------- Проверка полей ----------
    function money(v) { return v is int && v >= 0 && v <= 100000000000; }
    function text(v, max) { return v is string && v.size() <= max; }
    function nonEmpty(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optDate(v) { return v == null || isDate(v); }
    function id(v) { return v is string && v.size() > 0 && v.size() <= 128; }
    function optId(v) { return v == null || id(v); }
    function ms(v) { return v is int; }

    function validMember(d) {
      return d.keys().hasOnly(['name', 'role', 'active', 'created_ms'])
        && nonEmpty(d.name, 100) && text(d.role, 100) && d.active is bool
        && (!('created_ms' in d) || ms(d.created_ms));
    }

    function validProject(d) {
      return d.keys().hasOnly(['name', 'client', 'budget', 'status', 'start_date', 'notes', 'member_ids', 'created_ms'])
        && nonEmpty(d.name, 200) && text(d.client, 200) && money(d.budget)
        && d.status in ['active', 'paused', 'done']
        && optDate(d.start_date) && text(d.notes, 5000)
        && d.member_ids is list && d.member_ids.size() <= 100
        && (!('created_ms' in d) || ms(d.created_ms));
    }

    function validIteration(d) {
      return d.keys().hasOnly(['project_id', 'title', 'price', 'status', 'date', 'notes', 'shares', 'sort', 'created_ms'])
        && id(d.project_id) && nonEmpty(d.title, 1000) && money(d.price)
        && d.status in ['planned', 'in_work', 'done', 'cancelled']
        && optDate(d.date) && text(d.notes, 5000)
        && d.shares is map && d.shares.size() <= 100
        && d.sort is int
        && (!('created_ms' in d) || ms(d.created_ms));
    }

    function validOperation(d) {
      return d.keys().hasOnly(['type', 'date', 'amount', 'project_id', 'member_id', 'from_member_id',
                               'category', 'comment', 'is_advance', 'created_by', 'created_ms'])
        && d.type in ['income', 'payout', 'expense', 'tax', 'penalty', 'transfer']
        && isDate(d.date)
        && money(d.amount) && d.amount > 0
        && optId(d.project_id) && optId(d.member_id) && optId(d.from_member_id)
        && text(d.category, 100) && text(d.comment, 2000)
        && d.is_advance is bool
        && (d.type in ['income', 'payout', 'penalty'] ? id(d.project_id) : true)
        && (d.type in ['payout', 'penalty', 'transfer'] ? id(d.member_id) : true)
        && (d.type == 'transfer' ? id(d.from_member_id) : true);
    }

    // Документ — либо ссылка (url, только https), либо файл в Storage (storage_path в папке этого сотрудника)
    function validDocument(d) {
      return d.keys().hasOnly(['member_id', 'title', 'kind', 'url', 'storage_path', 'file_name', 'size', 'content_type',
                               'date', 'notes', 'created_ms'])
        && id(d.member_id) && nonEmpty(d.title, 300)
        && d.kind in ['contract', 'act', 'nda', 'invoice', 'other']
        && (
          (d.get('url', null) is string && d.url.size() <= 2000 && d.url.matches('^https://.+')
            && d.get('storage_path', null) == null)
          || (d.get('storage_path', null) is string && d.storage_path.size() <= 600
            && d.storage_path.matches('^documents/' + d.member_id + '/[^/]+/[^/]+$')
            && d.get('url', null) == null
            && text(d.get('file_name', ''), 300) && d.get('size', 0) is int && text(d.get('content_type', ''), 200))
        )
        && optDate(d.date) && text(d.notes, 2000)
        && (!('created_ms' in d) || ms(d.created_ms));
    }

    function validAccount(d) {
      return d.keys().hasOnly(['name', 'bank', 'rate', 'capitalization', 'opened', 'notes', 'archived', 'created_ms'])
        && nonEmpty(d.name, 200) && text(d.bank, 200)
        && d.rate is number && d.rate >= 0 && d.rate <= 100
        && d.capitalization in ['daily', 'monthly', 'none']
        && optDate(d.opened) && text(d.notes, 2000) && d.archived is bool
        && (!('created_ms' in d) || ms(d.created_ms));
    }

    function validAccountOp(d) {
      return d.keys().hasOnly(['account_id', 'type', 'date', 'amount', 'rate', 'comment', 'created_ms'])
        && id(d.account_id) && isDate(d.date) && text(d.comment, 1000)
        && d.type in ['deposit', 'withdraw', 'interest', 'rate']
        && (d.type == 'rate'
              ? (d.rate is number && d.rate >= 0 && d.rate <= 100)
              : (money(d.amount) && d.amount > 0))
        && (!('created_ms' in d) || ms(d.created_ms));
    }

    // ---------- Коллекции ----------
    match /access/{key} {
      allow read: if isAdmin() || (signedIn() && key == email());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'name', 'added_ms', 'member_id'])
        && request.resource.data.role in ['admin', 'viewer', 'employee']
        && (request.resource.data.role != 'employee' || id(request.resource.data.get('member_id', null)))
        && text(request.resource.data.get('name', ''), 100)
        // Администратор не может случайно лишить прав сам себя
        && (key != email() || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && key != email();
    }

    match /members/{doc} {
      allow read: if canRead();
      allow create, update: if isAdmin() && validMember(request.resource.data);
      allow delete: if isAdmin();
    }

    match /projects/{doc} {
      allow read: if canRead();
      allow create, update: if isAdmin() && validProject(request.resource.data);
      allow delete: if isAdmin();
    }

    match /iterations/{doc} {
      allow read: if canRead();
      allow create: if isAdmin() && validIteration(request.resource.data);
      // Итерацию нельзя перенести в другой проект
      allow update: if isAdmin() && validIteration(request.resource.data)
        && request.resource.data.project_id == resource.data.project_id;
      allow delete: if isAdmin();
    }

    // Выписка сотрудника: пересчитывается приложением администратора при каждом изменении данных
    match /statements/{memberId} {
      allow read: if canRead() || isEmployee(memberId);
      allow write: if isAdmin();
    }

    match /documents/{doc} {
      allow read: if canRead() || isEmployee(resource.data.member_id);
      allow create: if isAdmin() && validDocument(request.resource.data);
      // Файл документа не перепривязывается к другому сотруднику или файлу
      allow update: if isAdmin() && validDocument(request.resource.data)
        && request.resource.data.member_id == resource.data.member_id
        && request.resource.data.get('storage_path', null) == resource.data.get('storage_path', null);
      allow delete: if isAdmin();
    }

    match /accounts/{doc} {
      allow read: if canRead();
      allow create, update: if isAdmin() && validAccount(request.resource.data);
      allow delete: if isAdmin();
    }

    match /account_ops/{doc} {
      allow read: if canRead();
      allow create, update: if isAdmin() && validAccountOp(request.resource.data);
      allow delete: if isAdmin();
    }

    // Журнал изменений: пишет только администратор от своего имени и со временем сервера; править и удалять нельзя
    match /audit/{doc} {
      allow read: if canRead();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['at', 'at_ms', 'user', 'action', 'entity', 'entity_id', 'label', 'changes', 'snapshot'])
        && request.resource.data.at == request.time
        && request.resource.data.user == email()
        && ms(request.resource.data.at_ms)
        && request.resource.data.action in ['create', 'update', 'delete']
        && request.resource.data.entity in ['operation', 'project', 'iteration', 'member', 'document', 'account', 'account_op', 'access', 'import', 'demo']
        && text(request.resource.data.entity_id, 300)
        && text(request.resource.data.label, 500)
        && request.resource.data.changes is list && request.resource.data.changes.size() <= 100
        && (request.resource.data.snapshot == null || request.resource.data.snapshot is map);
      allow update, delete: if false;
    }

    match /operations/{doc} {
      allow read: if canRead();
      allow create: if isAdmin() && validOperation(request.resource.data)
        && request.resource.data.created_by == email()
        && ms(request.resource.data.created_ms);
      // Автор и время создания не меняются
      allow update: if isAdmin() && validOperation(request.resource.data)
        && request.resource.data.get('created_by', null) == resource.data.get('created_by', null)
        && request.resource.data.get('created_ms', null) == resource.data.get('created_ms', null);
      allow delete: if isAdmin();
    }
  }
}
