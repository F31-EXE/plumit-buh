# Конфигурация уже лежит в .env (проект plumit-buh). Этот файл — образец для другого проекта:
# скопируйте в .env.local и заполните значениями из консоли Firebase (Настройки проекта → Ваши приложения → Конфигурация SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
